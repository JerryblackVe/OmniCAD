+def _xyz_api(valores, que):
+    if not isinstance(valores, (list, tuple)) or len(valores) != 3:
+        raise error("INVALID_ARGUMENTS", f"{que} tiene que ser [x, y, z] (3 valores): recibió {valores!r}.")
+    return [texto_expr(v) for v in valores]

{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":\"OBLIGATORIO (regla de OmniCAD): en todo trabajo de codigo, invocar con la herramienta Skill las skills de docs/brief.md punto 1: fable-method y ponytail al empezar, verify-before-commit antes de commitear y ponytail-review antes de cerrar. No alcanza con leer la regla: hay que invocar la skill.\"}}'",
            "statusMessage": "Cargando regla ponytail"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/inicio.sh",
            "statusMessage": "Lista de arranque"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/aviso_commit.py"
          }
        ]
      },
      {
        "matcher": "mcp__ccd_session__start_session",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/start_session.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ctx25.py"
          }
        ]
      }
    ]
  }
}
